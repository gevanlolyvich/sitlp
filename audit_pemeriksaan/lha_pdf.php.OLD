     </tr>
     <tr>
      <td><b>Akibat</b></td>
      <td>{$temuan['akibat']}</td>
     </tr>
     <tr>
      <td><b>Risiko</b></td>
      <td>{$temuan['tingkat_risiko']}</td>
     </tr>
    </table>
    <br><br>
    ";
    $pdf->writeHTML($html,true,false,true,false,'');
}
mysqli_data_seek($qTemuan,0);


/* bab 3, rekomendasi */
$pdf->AddPage();
$pdf->Bookmark('BAB III - Rekomendasi',0,0);
