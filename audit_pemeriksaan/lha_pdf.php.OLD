//$pdf->AddPage('L');
$pdf->Bookmark('BAB IV - Tindak Lanjut',0,0);
$pdf->SetFont('helvetica','B',8);
$pdf->Cell(0,10,'BAB IV',0,1,'C');
$pdf->Cell(0,10,'TINDAK LANJUT',0,1,'C');
